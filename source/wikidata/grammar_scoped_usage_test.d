private OriginalLexemeReceipt makeReceipt(string raw)
{
    auto hex = toHexString(sha256Of(cast(const(ubyte)[])raw));
    string lower;
    foreach (c; hex)
        lower ~= (c >= 'A' && c <= 'F') ? cast(char)(c + 32) : c;
    return verifyOriginalLexemeBytes(raw, SourceSnapshotRef("L900001", 71, lower,
        "https://www.wikidata.org/wiki/Special:EntityData/L900001.json"));
}
private ScopedUsageExample findById(ScopedUsageBatch b, string id)
{
    foreach (e; b.examples) if (e.source.statementId == id) return e;
    assert(false, "Missing synthetic statement: " ~ id);
    return ScopedUsageExample.init;
}
