    assert(pair.source.referenceCount == 1 && pair.source.ownerId == "L900001");
    assert(!pair.permitsGrammarProduction && !pair.permitsFormSelection &&
        !pair.permitsGeneralFormSenseAssociation);
    assert(findById(b, "L900001$formonly").status == ScopedUsageStatus.explicitFormQualifierOnly);
